{
  "name": "calystr",
  "version": "1.0.0",
  "description": "Commercial Product Standard Compiler — compile engineering, product design and verification knowledge into executable standards for Pi.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pi-package",
    "commercial-product-standard",
    "agent-harness",
    "verification"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HughZadora/calystr.git"
  },
  "packageManager": "pnpm@12.1.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "bin": {
    "calystr": "compiler/package/cli.mjs"
  },
  "scripts": {
    "test": "node scripts/verify-structure.mjs && node --test",
    "verify:structure": "node scripts/verify-structure.mjs",
    "golden": "node compiler/package/cli.mjs golden",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:markdown": "markdownlint-cli2 \"**/*.md\" \"!node_modules/**\"",
    "lint:links": "markdown-link-check -q -c .markdown-link-check.json README.md AGENTS.md CHANGELOG.md CONTRIBUTING.md SECURITY.md adapters compiler docs examples mappings model policy sources standard tests .github",
    "typecheck": "tsc --noEmit",
    "quality:diff": "lint-staged --continue-on-error",
    "quality:all": "pnpm run format:check && pnpm run lint:eslint && pnpm run lint:markdown && pnpm run lint:links && pnpm run typecheck"
  },
  "pi": {
    "extensions": [
      "adapters/pi/extensions/calystr.ts"
    ],
    "skills": [
      "adapters/pi/skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "eslint": "10.9.1",
    "lint-staged": "17.4.1",
    "markdown-link-check": "3.15.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "files": [
    "model",
    "sources",
    "mappings",
    "standard",
    "compiler",
    "policy",
    "adapters",
    "examples",
    "docs",
    "cue.mod",
    "scripts",
    "VERSION",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ]
}
